{
  inputs = {
    xnodeos.url = "github:Openmesh-Network/xnodeos/v2";
    nixpkgs.follows = "xnodeos/nixpkgs";
  };

  outputs = inputs: {
    nixosModules = {
      default =
        { pkgs, ... }@args:
        {
          imports = [
            inputs.xnodeos.nixosModules.app
          ];

          config =
            let
              domain =
                if (builtins.pathExists "${args.config.xnode.xnode-config}/domain") then
                  builtins.readFile "${args.config.xnode.xnode-config}/domain"
                else
                  "";
              owner =
                if (builtins.pathExists "${args.config.xnode.xnode-config}/owner") then
                  builtins.readFile "${args.config.xnode.xnode-config}/owner"
                else
                  "";
            in
            {
              services.forgejo.enable = true;
              services.forgejo.settings.server.DOMAIN = args.lib.mkIf (domain != "") domain;
              services.forgejo.settings.server.ROOT_URL = args.lib.mkIf (domain != "") "https://${domain}/";
              services.forgejo.settings.server.HTTP_ADDR = "127.0.0.1";
              services.forgejo.settings.server.HTTP_PORT = 3000;
              services.forgejo.database.type = "postgres";

              services.forgejo.lfs.enable = true;
              services.forgejo.settings.actions.ENABLED = true;

              xnode.reverse-proxy.https = args.lib.mkIf (domain != "") {
                ${domain}."/".locations = [
                  {
                    domain = args.config.services.forgejo.settings.server.HTTP_ADDR;
                    port = args.config.services.forgejo.settings.server.HTTP_PORT;
                  }
                ];
              };

              services.xnode-auth.domains = args.lib.mkIf (domain != "" && owner != "") {
                ${domain} = {
                  accessList = {
                    users = {
                      ${owner} = {
                        roles = [ "owner" ];
                      };
                    };
                    roles = {
                      "owner" = { };
                    };
                  };
                  paths = builtins.attrNames args.config.xnode.reverse-proxy.https.${domain};
                };
              };
            };
        };
    };
  };
}
